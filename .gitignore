# Repositório público: nada de segredo ou configuração de máquina aqui.
# `*.local` acima não pega `settings.local.json` — o padrão exige terminar em `.local`.
.claude/settings.local.json
.env
.env.*
*.pem
*.key

# Ferramenta de design (skill impeccable): 3,4MB e 148 arquivos de código de
# terceiro. Reinstalável, não é código do projeto, e o hook em
# settings.local.json já é guardado por `[ ! -f ... ] || node ...` — sem a
# skill presente ele simplesmente não roda.
.claude/skills/
.claude/worktrees/
# cache do detector, regenerado a cada edição
.impeccable/hook.cache.json
